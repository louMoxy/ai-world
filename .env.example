# Copy this file to .env and fill it in. .env is never committed to git.
# These settings are read by the island's server only; they never reach the browser.

# Your Anthropic API key (stage 3). Create one at https://console.anthropic.com
# and set a monthly spend limit there too.
ANTHROPIC_API_KEY=

# The most the island may spend on AI per day, in US dollars. 0 turns AI off.
DAILY_AI_BUDGET_USD=0.50
